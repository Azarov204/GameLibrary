<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLibrary.Pages.GameDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLibrary.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">


    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Spacing="0">

            <!-- Hero image: full width, no surrounding padding -->
            <Grid Height="320" HorizontalAlignment="Stretch">
                <canvas:CanvasControl
                    x:Name="HeroBlurCanvas"
                    CreateResources="HeroBlurCanvas_CreateResources"
                    Draw="HeroBlurCanvas_Draw"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

                <Rectangle Fill="#33000000" />

                <!-- Back button overlays the hero -->
                <Button
                    Content="← Back"
                    Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20,20,0,0"
                    Padding="12,8"
                    Background="#99000000"
                    Foreground="White" />
            </Grid>

            <!-- Scrollable game information -->
            <Grid
                Padding="24"
                RowSpacing="20"
                Background="#423D5B"
                RequestedTheme="Dark">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="16">

                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="32"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="{Binding Description}"
                        TextWrapping="Wrap"
                        FontSize="16" />

                    <TextBlock Text="{Binding Developer}" />
                    <TextBlock Text="{Binding Platform}" />
                    <TextBlock Text="{Binding ReleaseDate}" />
                    <TextBlock Text="{Binding PlayTimeMinutes}" />

                    <TextBlock
                        Text="{Binding InstalledDirectory}"
                        TextWrapping="Wrap" />

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
